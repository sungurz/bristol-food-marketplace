    <bpmn:sendTask id="Activity_0voyo3c" name="Send each producer its confirmed order + allocation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="b-producer"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15jh3av</bpmn:incoming>
      <bpmn:outgoing>Flow_19awlzm</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=producerOrders" inputElement="producerOrder"/>
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:sendTask>
    <bpmn:sendTask id="Activity_RequestCardValidation" name="Request card validation">
      <bpmn:documentation>Generate a fresh cardCheckId string per submission and reuse it across retries of the same job. Publish CardValidationRequest with testCardToken and cardCheckId, using cardCheckId as the correlation key. Complete the job with cardCheckId and reset cardValid to false for the new check.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="b-request-card-validation"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ikaqwy</bpmn:incoming>
      <bpmn:outgoing>Flow_SendCheckToReceive</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_ReceiveCardValidation" name="Receive card validation result" messageRef="Message_CardValidationResult">
      <bpmn:incoming>Flow_SendCheckToReceive</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveCheckToDecision</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_TestCardValid" name="Test card valid?" default="Flow_CardInvalid">
      <bpmn:incoming>Flow_ReceiveCheckToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_CardValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_CardInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_NotifyCardCheckFailed" name="Notify customer of card check failure">
      <bpmn:documentation>Publish CardCheckFailed with orderId as the correlation key. Use a positive message TTL so the notification can wait for the customer subscription.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="b-notify-card-check-failed"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CardInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_FailureNotifiedToMerge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_ResumeWaitingForCustomer">
      <bpmn:incoming>Flow_1mz257w</bpmn:incoming>
      <bpmn:incoming>Flow_FailureNotifiedToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToWaitForCustomer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_SendCheckToReceive" sourceRef="Activity_RequestCardValidation" targetRef="Activity_ReceiveCardValidation"/>
    <bpmn:sequenceFlow id="Flow_ReceiveCheckToDecision" sourceRef="Activity_ReceiveCardValidation" targetRef="Gateway_TestCardValid"/>
    <bpmn:sequenceFlow id="Flow_CardValid" sourceRef="Gateway_TestCardValid" targetRef="Activity_13z3zv9" name="Valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= cardValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CardInvalid" sourceRef="Gateway_TestCardValid" targetRef="Activity_NotifyCardCheckFailed" name="Invalid or missing"/>
    <bpmn:sequenceFlow id="Flow_FailureNotifiedToMerge" sourceRef="Activity_NotifyCardCheckFailed" targetRef="Gateway_ResumeWaitingForCustomer"/>
    <bpmn:sequenceFlow id="Flow_MergeToWaitForCustomer" sourceRef="Gateway_ResumeWaitingForCustomer" targetRef="Gateway_0mi78ir" name="Wait for new details or cancellation"/>
  </bpmn:process>
  <bpmn:process id="Process_CardValidationService" name="Sandbox card validation" isExecutable="true">
    <bpmn:startEvent id="Event_CardCheckRequested" name="Card check requested">
      <bpmn:outgoing>Flow_CheckRequestedToVerify</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_CardCheckRequest" messageRef="Message_CardValidationRequest"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_VerifySandboxCard" name="Verify sandbox test card">
      <bpmn:documentation>Check testCardToken against the configured sandbox test tokens. Set the Boolean cardValid. Return false for an invalid or missing token and use simulated card data only.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-sandbox-test-card"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CheckRequestedToVerify</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyToReturnCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_ReturnCardCheckResult" name="Return card validation result">
      <bpmn:documentation>Publish CardValidationResult with Boolean cardValid and the incoming cardCheckId as the correlation key. Use a positive message TTL so the reply can wait for the marketplace subscription.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="return-card-validation-result"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_VerifyToReturnCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnCheckToEnd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_CardCheckComplete" name="Card check complete">
      <bpmn:incoming>Flow_ReturnCheckToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CheckRequestedToVerify" sourceRef="Event_CardCheckRequested" targetRef="Activity_VerifySandboxCard"/>
    <bpmn:sequenceFlow id="Flow_VerifyToReturnCheck" sourceRef="Activity_VerifySandboxCard" targetRef="Activity_ReturnCardCheckResult"/>
    <bpmn:sequenceFlow id="Flow_ReturnCheckToEnd" sourceRef="Activity_ReturnCardCheckResult" targetRef="Event_CardCheckComplete"/>
  </bpmn:process>
