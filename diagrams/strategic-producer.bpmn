<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Producer" targetNamespace="https://bristol-food-marketplace.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Message_Order" name="Producer order notification"/>
  <bpmn:message id="Message_Statement" name="Weekly settlement statement"/>
  <bpmn:collaboration id="Collaboration_Producer">
    <bpmn:participant id="Pool_Marketplace" name="Bristol Regional Food Network marketplace"/>
    <bpmn:participant id="Pool_Payment" name="Payment provider - test environment"/>
    <bpmn:participant id="Pool_Catalogue" name="Product and stock information" processRef="Process_Catalogue"/>
    <bpmn:participant id="Pool_Orders" name="Order fulfilment" processRef="Process_Orders"/>
    <bpmn:participant id="Pool_Accounts" name="Accounts and settlements" processRef="Process_Accounts"/>
    <bpmn:participant id="Pool_Safety" name="Food safety" processRef="Process_Safety"/>
    <bpmn:participant id="Pool_Community" name="Community activity" processRef="Process_Community"/>
    <bpmn:messageFlow id="PayoutInstruction" sourceRef="Pool_Marketplace" targetRef="Pool_Payment" name="Weekly payout instruction&#10;(net of 5% commission)"/>
    <bpmn:messageFlow id="TransferResult" sourceRef="Pool_Payment" targetRef="Pool_Marketplace" name="Transfer result&#10;(test environment)"/>
    <bpmn:messageFlow id="CatalogueUpdate" sourceRef="Sub_Catalogue" targetRef="Pool_Marketplace" name="Product, stock and traceability updates"/>
    <bpmn:messageFlow id="IncomingOrder" sourceRef="Pool_Marketplace" targetRef="Start_Orders" name="Producer order and fulfilment details"/>
    <bpmn:messageFlow id="OrderAccepted" sourceRef="Sub_Orders" targetRef="Pool_Marketplace" name="Order accepted and arrangements confirmed"/>
    <bpmn:messageFlow id="WeeklyStatement" sourceRef="Pool_Marketplace" targetRef="Start_Accounts" name="Weekly settlement statement and payout status"/>
    <bpmn:messageFlow id="SettlementResponse" sourceRef="Pool_Marketplace" targetRef="Sub_Accounts" name="Settlement response (if queried)"/>
    <bpmn:messageFlow id="SettlementQuery" sourceRef="Sub_Accounts" targetRef="Pool_Marketplace" name="Settlement query (if records differ)"/>
    <bpmn:messageFlow id="SafetyAlert" sourceRef="Pool_Marketplace" targetRef="Sub_Safety" name="Safety alert and affected order details"/>
    <bpmn:messageFlow id="SafetyCommunication" sourceRef="Sub_Safety" targetRef="Pool_Marketplace" name="Affected products / orders and safety response"/>
    <bpmn:messageFlow id="CommunityUpdate" sourceRef="Sub_Community" targetRef="Pool_Marketplace" name="Surplus discounts / seasonal learning content"/>
    <bpmn:messageFlow id="OrderUnavailable" sourceRef="Sub_Orders" targetRef="Pool_Marketplace" name="Order unavailable or timing unsuitable"/><bpmn:messageFlow id="OrderFulfilled" sourceRef="Sub_Orders" targetRef="Pool_Marketplace" name="Order fulfilled and handover recorded"/><bpmn:textAnnotation id="Scope_Note">
      <bpmn:text>PRODUCER STRATEGIC VIEW
The grouped process views all belong to the same local food producer. Each has its own trigger.
Matching record symbols refer to the same shared information. Open + for supporting detail.
This file describes business responsibilities; engine automation is a separate implementation step.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Platform_Note">
      <bpmn:text>MARKETPLACE RESPONSIBILITY
Calculate the 5% commission automatically.
Instruct weekly producer payouts.
Provide settlement statements and audit trails.
Pass transfer status to producers.

Design assumption: financial updates are delivered through the marketplace.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="LeadTime_Note">
      <bpmn:text>ORDER REQUIREMENT
At least 48 hours preparation lead time.
Check stock and timing before fulfilment.</bpmn:text>
    </bpmn:textAnnotation>
  <bpmn:group id="Group_OneProducer" categoryValueRef="CategoryValue_ProducerOrganisation"/><bpmn:textAnnotation id="Record_Legend"><bpmn:text>READING THE RECORD CONNECTIONS
Cylinder = records kept between process instances.
Dotted arrow into an activity = records read.
Dotted arrow out = records created or updated.
Matching labels refer to the same shared record set.
These symbols describe information needs; they do not create a database.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Order_Message_Note"><bpmn:text>ORDER STATUS MESSAGES
Accepted: sent after stock is allocated and arrangements confirmed.
Unavailable: sent if stock or timing is unsuitable; that route ends.
Fulfilled: sent after the accepted order is handed over.
These are separate stages and alternatives, not three messages always sent together.</bpmn:text></bpmn:textAnnotation></bpmn:collaboration>
  <bpmn:process id="Process_Catalogue" name="Producer - Product information" isExecutable="false">
    <bpmn:documentation>Issue #15: producer-side strategic BPMN in strategic-producer.bpmn. This is one process view of the same local food producer, grouped with its other responsibilities. Separate process boundaries represent independently triggered work, not separate businesses or mandatory separate departments. Shared data-store references link catalogue/stock, orders, accounting and food safety responsibilities. Message flows show business information exchanges with the marketplace and payment provider; they do not implement API calls or money transfers. The model is intentionally non-executable. Camunda 8 deployment validation reports that no process is executable; do not mark it executable solely to hide that notice. An operational implementation needs actual task types, forms, variables, gateway conditions, service workers, message subscriptions and exception handling. Source requirements: Case Study - v2.pdf pp.1-2; strategic modelling requirement: Task 1 brief p.3. Allocation rules and delivery of financial updates through the marketplace are explicit design assumptions for later agreement.</bpmn:documentation><bpmn:startEvent id="Start_Catalogue" name="Product or stock&#10;change">
      <bpmn:outgoing>Flow_Catalogue_In</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_Catalogue" name="Manage products, availability&#10;and traceability information">
      <bpmn:documentation>Product management and traceability responsibilities from the case study. Initial listing and later changes use this workflow. Postcode distance calculations are marketplace responsibilities.</bpmn:documentation>
      <bpmn:incoming>Flow_Catalogue_In</bpmn:incoming>
      <bpmn:outgoing>Flow_Catalogue_Out</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Catalogue"><bpmn:dataOutput id="Output_Catalogue_Products" name="Products, stock and batches"/><bpmn:inputSet id="InputSet_Catalogue"/><bpmn:outputSet id="OutputSet_Catalogue"><bpmn:dataOutputRefs>Output_Catalogue_Products</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:dataOutputAssociation id="Write_Catalogue_Products"><bpmn:sourceRef>Output_Catalogue_Products</bpmn:sourceRef><bpmn:targetRef>Records_Catalogue_Products</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:startEvent id="Catalogue_Start" name="">
        <bpmn:outgoing>Catalogue_F0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Catalogue_Task0" name="Maintain products and&#10;seasonal stock">
        <bpmn:documentation>Names, descriptions, prices, stock levels, availability windows and harvest dates.</bpmn:documentation>
        <bpmn:incoming>Catalogue_F0</bpmn:incoming>
        <bpmn:outgoing>Catalogue_F1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Catalogue_F0" sourceRef="Catalogue_Start" targetRef="Catalogue_Task0"/>
      <bpmn:task id="Catalogue_Task1" name="Maintain origin and&#10;safety information">
        <bpmn:documentation>Farm origin and postcode, organic certification status, allergens, best-before dates and traceability records. Marketplace calculates food miles using supplied origin data.</bpmn:documentation>
        <bpmn:incoming>Catalogue_F1</bpmn:incoming>
        <bpmn:outgoing>Catalogue_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Catalogue_F1" sourceRef="Catalogue_Task0" targetRef="Catalogue_Task1"/>
      <bpmn:task id="Catalogue_Task2" name="Publish updates&#10;to marketplace">
        <bpmn:documentation>Create and update catalogue records. Seasonal inventory maintenance must suit producers with varied technical skills.</bpmn:documentation>
        <bpmn:incoming>Catalogue_F2</bpmn:incoming>
        <bpmn:outgoing>Catalogue_FEnd</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Catalogue_F2" sourceRef="Catalogue_Task1" targetRef="Catalogue_Task2"/>
      <bpmn:endEvent id="Catalogue_End" name="">
        <bpmn:incoming>Catalogue_FEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Catalogue_FEnd" sourceRef="Catalogue_Task2" targetRef="Catalogue_End"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Catalogue" name="Listings&#10;updated">
      <bpmn:incoming>Flow_Catalogue_Out</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Catalogue_In" sourceRef="Start_Catalogue" targetRef="Sub_Catalogue"/>
    <bpmn:sequenceFlow id="Flow_Catalogue_Out" sourceRef="Sub_Catalogue" targetRef="End_Catalogue"/>
  <bpmn:dataStoreReference id="Records_Catalogue_Products" name="Products, stock&#10;and batches" dataStoreRef="DataStore_Products"><bpmn:documentation>WRITE. This symbol refers to the same shared record set as matching symbols in the other producer processes. Product identifiers, names, descriptions, prices, availability, stock/allocation quantities, farm origin, postcode, harvest dates, certification status, allergens, best-before dates and batch traceability.</bpmn:documentation></bpmn:dataStoreReference></bpmn:process>
  <bpmn:process id="Process_Orders" name="Producer - Order fulfilment" isExecutable="false">
    <bpmn:documentation>Issue #15: producer-side strategic BPMN in strategic-producer.bpmn. This is one process view of the same local food producer, grouped with its other responsibilities. Separate process boundaries represent independently triggered work, not separate businesses or mandatory separate departments. Shared data-store references link catalogue/stock, orders, accounting and food safety responsibilities. Message flows show business information exchanges with the marketplace and payment provider; they do not implement API calls or money transfers. The model is intentionally non-executable. Camunda 8 deployment validation reports that no process is executable; do not mark it executable solely to hide that notice. An operational implementation needs actual task types, forms, variables, gateway conditions, service workers, message subscriptions and exception handling. Source requirements: Case Study - v2.pdf pp.1-2; strategic modelling requirement: Task 1 brief p.3. Allocation rules and delivery of financial updates through the marketplace are explicit design assumptions for later agreement.</bpmn:documentation><bpmn:startEvent id="Start_Orders" name="Producer order&#10;received">
      <bpmn:outgoing>Flow_Orders_In</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Orders" messageRef="Message_Order"/>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_Orders" name="Review producer orders,&#10;allocate stock and coordinate fulfilment">
      <bpmn:documentation>One producer share of an order, including a multi-vendor order coordinated by the marketplace. Read shared product/stock records and check at least 48 hours preparation lead time. On acceptance, allocate available stock, record the producer order and send acceptance. On unavailability or unsuitable timing, record the issue and notify the marketplace; this route ends without fulfilment. On handover, record completed quantities, update stock consistently and send fulfilment status. The three overview messages are sent at different steps, not all on every route. Stock reservation and final physical-stock adjustment are proposed business rules to refine in operational design. Use one allocation record so fulfilling an already allocated quantity does not deduct available stock twice.</bpmn:documentation><bpmn:incoming>Flow_Orders_In</bpmn:incoming>
      <bpmn:outgoing>Flow_Orders_Out</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Orders"><bpmn:dataInput id="Input_Orders_Products" name="Products, stock and batches"/><bpmn:dataOutput id="Output_Orders_Products" name="Products, stock and batches"/><bpmn:dataOutput id="Output_Orders_Orders" name="Producer orders and fulfilment"/><bpmn:inputSet id="InputSet_Orders"><bpmn:dataInputRefs>Input_Orders_Products</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="OutputSet_Orders"><bpmn:dataOutputRefs>Output_Orders_Products</bpmn:dataOutputRefs><bpmn:dataOutputRefs>Output_Orders_Orders</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:dataInputAssociation id="Read_Orders_Products"><bpmn:sourceRef>Records_Orders_Products</bpmn:sourceRef><bpmn:targetRef>Input_Orders_Products</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="Write_Orders_Products"><bpmn:sourceRef>Output_Orders_Products</bpmn:sourceRef><bpmn:targetRef>Records_Orders_Products</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:dataOutputAssociation id="Write_Orders_Orders"><bpmn:sourceRef>Output_Orders_Orders</bpmn:sourceRef><bpmn:targetRef>Records_Orders_Orders</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:startEvent id="Orders_Start" name="">
        <bpmn:outgoing>Orders_FStart</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Orders_Review" name="Check stock, order details&#10;and 48-hour lead time">
        <bpmn:documentation>Use current stock/availability and the requested delivery or collection time. At least 48 hours preparation lead time is required. Business-level judgement is shown; no executable rule is claimed.</bpmn:documentation><bpmn:incoming>Orders_FStart</bpmn:incoming>
        <bpmn:outgoing>Orders_FDecision</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Orders_FStart" sourceRef="Orders_Start" targetRef="Orders_Review"/>
      <bpmn:exclusiveGateway id="Orders_Decision" name="Can order be fulfilled?">
        <bpmn:incoming>Orders_FDecision</bpmn:incoming>
        <bpmn:outgoing>Orders_FYes0</bpmn:outgoing>
        <bpmn:outgoing>Orders_FNo0</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Orders_FDecision" sourceRef="Orders_Review" targetRef="Orders_Decision"/>
      <bpmn:task id="Orders_Yes0" name="Allocate stock, record order&#10;and confirm acceptance">
        <bpmn:documentation>Record the producer share of the order, its item quantities and agreed arrangements. Allocate available stock and send acceptance to the marketplace. Allocation is a proposed design detail, not a case-study-specified algorithm.</bpmn:documentation><bpmn:incoming>Orders_FYes0</bpmn:incoming>
        <bpmn:outgoing>Orders_FYes1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Orders_FYes0" sourceRef="Orders_Decision" targetRef="Orders_Yes0" name="Yes"/>
      <bpmn:task id="Orders_Yes1" name="Prepare products and&#10;arrange delivery or collection">
        <bpmn:incoming>Orders_FYes1</bpmn:incoming>
        <bpmn:outgoing>Orders_FYes2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Orders_FYes1" sourceRef="Orders_Yes0" targetRef="Orders_Yes1"/>
      <bpmn:task id="Orders_Yes2" name="Record fulfilment, update stock&#10;and notify marketplace">
        <bpmn:documentation>Record actual fulfilled quantities and handover status in the shared order records. Convert the stock allocation to the completed sale and maintain accurate inventory without deducting the same quantity twice. Notify the marketplace that fulfilment is complete.</bpmn:documentation><bpmn:incoming>Orders_FYes2</bpmn:incoming>
        <bpmn:outgoing>Orders_FEndYes</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Orders_FYes2" sourceRef="Orders_Yes1" targetRef="Orders_Yes2"/>
      <bpmn:endEvent id="Orders_YesEnd" name="Fulfilled">
        <bpmn:incoming>Orders_FEndYes</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Orders_FEndYes" sourceRef="Orders_Yes2" targetRef="Orders_YesEnd"/>
      <bpmn:task id="Orders_No0" name="Record issue and notify&#10;marketplace of unavailability">
        <bpmn:documentation>Record why the order cannot be fulfilled and send an unavailability/timing issue notice. This branch does not confirm acceptance or proceed to preparation. Marketplace handling of replacement suppliers, customer changes and refunds is outside this producer strategic view.</bpmn:documentation><bpmn:incoming>Orders_FNo0</bpmn:incoming>
        <bpmn:outgoing>Orders_FEndNo</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Orders_FNo0" sourceRef="Orders_Decision" targetRef="Orders_No0" name="No"/>
      <bpmn:endEvent id="Orders_NoEnd" name="Issue reported">
        <bpmn:incoming>Orders_FEndNo</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Orders_FEndNo" sourceRef="Orders_No0" targetRef="Orders_NoEnd"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Orders" name="Order outcome&#10;recorded">
      <bpmn:incoming>Flow_Orders_Out</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Orders_In" sourceRef="Start_Orders" targetRef="Sub_Orders"/>
    <bpmn:sequenceFlow id="Flow_Orders_Out" sourceRef="Sub_Orders" targetRef="End_Orders"/>
  <bpmn:dataStoreReference id="Records_Orders_Products" name="Products, stock&#10;and batches" dataStoreRef="DataStore_Products"><bpmn:documentation>READ/WRITE. This symbol refers to the same shared record set as matching symbols in the other producer processes. Product identifiers, names, descriptions, prices, availability, stock/allocation quantities, farm origin, postcode, harvest dates, certification status, allergens, best-before dates and batch traceability.</bpmn:documentation></bpmn:dataStoreReference><bpmn:dataStoreReference id="Records_Orders_Orders" name="Producer orders&#10;and fulfilment" dataStoreRef="DataStore_Orders"><bpmn:documentation>WRITE. This symbol refers to the same shared record set as matching symbols in the other producer processes. Order and producer identifiers, product/batch identifiers, quantities, prices, requested and agreed handover times, acceptance or issue status, fulfilled quantities and handover evidence. Customer contact records remain with the marketplace; traceability is coordinated using order identifiers.</bpmn:documentation></bpmn:dataStoreReference></bpmn:process>
  <bpmn:process id="Process_Accounts" name="Producer - Accounts" isExecutable="false">
    <bpmn:documentation>Issue #15: producer-side strategic BPMN in strategic-producer.bpmn. This is one process view of the same local food producer, grouped with its other responsibilities. Separate process boundaries represent independently triggered work, not separate businesses or mandatory separate departments. Shared data-store references link catalogue/stock, orders, accounting and food safety responsibilities. Message flows show business information exchanges with the marketplace and payment provider; they do not implement API calls or money transfers. The model is intentionally non-executable. Camunda 8 deployment validation reports that no process is executable; do not mark it executable solely to hide that notice. An operational implementation needs actual task types, forms, variables, gateway conditions, service workers, message subscriptions and exception handling. Source requirements: Case Study - v2.pdf pp.1-2; strategic modelling requirement: Task 1 brief p.3. Allocation rules and delivery of financial updates through the marketplace are explicit design assumptions for later agreement.</bpmn:documentation><bpmn:startEvent id="Start_Accounts" name="Weekly statement&#10;received">
      <bpmn:outgoing>Flow_Accounts_In</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Accounts" messageRef="Message_Statement"/>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_Accounts" name="Reconcile weekly settlements&#10;and maintain audit records">
      <bpmn:documentation>Producer accounting reads the shared completed-order records and reads/writes the settlement record set. The marketplace calculates commission and initiates weekly payouts; the payment provider returns transfer results. The producer matches those results to fulfilled sales and raises discrepancies. Receiving the statement and transfer status through the marketplace is a proposed interface assumption. A pending or failed payout must not be recorded as successfully paid merely because a statement was received.</bpmn:documentation><bpmn:incoming>Flow_Accounts_In</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounts_Out</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Accounts"><bpmn:dataInput id="Input_Accounts_Orders" name="Producer orders and fulfilment"/><bpmn:dataInput id="Input_Accounts_Settlements" name="Settlements and accounting evidence"/><bpmn:dataOutput id="Output_Accounts_Settlements" name="Settlements and accounting evidence"/><bpmn:inputSet id="InputSet_Accounts"><bpmn:dataInputRefs>Input_Accounts_Orders</bpmn:dataInputRefs><bpmn:dataInputRefs>Input_Accounts_Settlements</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="OutputSet_Accounts"><bpmn:dataOutputRefs>Output_Accounts_Settlements</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:dataInputAssociation id="Read_Accounts_Orders"><bpmn:sourceRef>Records_Accounts_Orders</bpmn:sourceRef><bpmn:targetRef>Input_Accounts_Orders</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataInputAssociation id="Read_Accounts_Settlements"><bpmn:sourceRef>Records_Accounts_Settlements</bpmn:sourceRef><bpmn:targetRef>Input_Accounts_Settlements</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="Write_Accounts_Settlements"><bpmn:sourceRef>Output_Accounts_Settlements</bpmn:sourceRef><bpmn:targetRef>Records_Accounts_Settlements</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:startEvent id="Accounts_Start" name="">
        <bpmn:outgoing>Accounts_FStart</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Accounts_Review" name="Match statement and payout&#10;to completed producer sales">
        <bpmn:documentation>Read producer orders and fulfilment evidence. Compare completed sales with statement line items, prices, gross sales, the marketplace-calculated 5% fee, expected net amount and actual transfer status. For an applicable gross amount of 100, the stated 5% commission is 5 and the net is 95 before any separately agreed adjustments; no extra fees or refund rules are assumed.</bpmn:documentation><bpmn:incoming>Accounts_FStart</bpmn:incoming>
        <bpmn:outgoing>Accounts_FDecision</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Accounts_FStart" sourceRef="Accounts_Start" targetRef="Accounts_Review"/>
      <bpmn:exclusiveGateway id="Accounts_Decision" name="Statement and payout agree?">
        <bpmn:incoming>Accounts_FDecision</bpmn:incoming>
        <bpmn:outgoing>Accounts_FYes0</bpmn:outgoing>
        <bpmn:outgoing>Accounts_FNo0</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Accounts_FDecision" sourceRef="Accounts_Review" targetRef="Accounts_Decision"/>
      <bpmn:task id="Accounts_Yes0" name="Record reconciled settlement&#10;and retain audit evidence">
        <bpmn:documentation>Write reconciliation results and retain statement/payment evidence in the shared settlement records. Link each statement item to the relevant producer order or sale. If an issue was raised, retain its response and resolution evidence.</bpmn:documentation><bpmn:incoming>Accounts_FYes0</bpmn:incoming>
        <bpmn:outgoing>Accounts_FEndYes</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Accounts_FYes0" sourceRef="Accounts_Decision" targetRef="Accounts_Yes0" name="Yes"/>
      <bpmn:endEvent id="Accounts_YesEnd" name="Accounts updated">
        <bpmn:incoming>Accounts_FEndYes</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Accounts_FEndYes" sourceRef="Accounts_Yes0" targetRef="Accounts_YesEnd"/>
      <bpmn:task id="Accounts_No0" name="Query marketplace and&#10;resolve discrepancy or payout issue">
        <bpmn:incoming>Accounts_FNo0</bpmn:incoming>
        <bpmn:outgoing>Accounts_FNo1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Accounts_FNo0" sourceRef="Accounts_Decision" targetRef="Accounts_No0" name="No"/>
      <bpmn:task id="Accounts_No1" name="Record corrected settlement&#10;and retain audit evidence">
        <bpmn:documentation>Write reconciliation results and retain statement/payment evidence in the shared settlement records. Link each statement item to the relevant producer order or sale. If an issue was raised, retain its response and resolution evidence.</bpmn:documentation><bpmn:incoming>Accounts_FNo1</bpmn:incoming>
        <bpmn:outgoing>Accounts_FEndNo</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Accounts_FNo1" sourceRef="Accounts_No0" targetRef="Accounts_No1"/>
      <bpmn:endEvent id="Accounts_NoEnd" name="Accounts updated">
        <bpmn:incoming>Accounts_FEndNo</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Accounts_FEndNo" sourceRef="Accounts_No1" targetRef="Accounts_NoEnd"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Accounts" name="Accounts&#10;reconciled">
      <bpmn:incoming>Flow_Accounts_Out</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Accounts_In" sourceRef="Start_Accounts" targetRef="Sub_Accounts"/>
    <bpmn:sequenceFlow id="Flow_Accounts_Out" sourceRef="Sub_Accounts" targetRef="End_Accounts"/>
  <bpmn:dataStoreReference id="Records_Accounts_Orders" name="Producer orders&#10;and fulfilment" dataStoreRef="DataStore_Orders"><bpmn:documentation>READ. This symbol refers to the same shared record set as matching symbols in the other producer processes. Order and producer identifiers, product/batch identifiers, quantities, prices, requested and agreed handover times, acceptance or issue status, fulfilled quantities and handover evidence. Customer contact records remain with the marketplace; traceability is coordinated using order identifiers.</bpmn:documentation></bpmn:dataStoreReference><bpmn:dataStoreReference id="Records_Accounts_Settlements" name="Settlements and&#10;accounting evidence" dataStoreRef="DataStore_Settlements"><bpmn:documentation>READ/WRITE. This symbol refers to the same shared record set as matching symbols in the other producer processes. Weekly statement identifiers and line items, matched completed sales, gross sales, 5% commission, net amount, payment-provider transfer status, reconciliation results and query correspondence.</bpmn:documentation></bpmn:dataStoreReference></bpmn:process>
  <bpmn:process id="Process_Safety" name="Producer - Food safety" isExecutable="false">
    <bpmn:documentation>Issue #15: producer-side strategic BPMN in strategic-producer.bpmn. This is one process view of the same local food producer, grouped with its other responsibilities. Separate process boundaries represent independently triggered work, not separate businesses or mandatory separate departments. Shared data-store references link catalogue/stock, orders, accounting and food safety responsibilities. Message flows show business information exchanges with the marketplace and payment provider; they do not implement API calls or money transfers. The model is intentionally non-executable. Camunda 8 deployment validation reports that no process is executable; do not mark it executable solely to hide that notice. An operational implementation needs actual task types, forms, variables, gateway conditions, service workers, message subscriptions and exception handling. Source requirements: Case Study - v2.pdf pp.1-2; strategic modelling requirement: Task 1 brief p.3. Allocation rules and delivery of financial updates through the marketplace are explicit design assumptions for later agreement.</bpmn:documentation><bpmn:startEvent id="Start_Safety" name="Safety concern&#10;raised">
      <bpmn:outgoing>Flow_Safety_In</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_Safety" name="Trace affected products and&#10;coordinate safety communication">
      <bpmn:documentation>Producer quality assurance and safety communication. The marketplace holds customer-product-producer links and coordinates customer contact. Proposed response details require group agreement.</bpmn:documentation>
      <bpmn:incoming>Flow_Safety_In</bpmn:incoming>
      <bpmn:outgoing>Flow_Safety_Out</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Safety"><bpmn:dataInput id="Input_Safety_Products" name="Products, stock and batches"/><bpmn:dataInput id="Input_Safety_Orders" name="Producer orders and fulfilment"/><bpmn:dataOutput id="Output_Safety_Safety" name="Safety response records"/><bpmn:inputSet id="InputSet_Safety"><bpmn:dataInputRefs>Input_Safety_Products</bpmn:dataInputRefs><bpmn:dataInputRefs>Input_Safety_Orders</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="OutputSet_Safety"><bpmn:dataOutputRefs>Output_Safety_Safety</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:dataInputAssociation id="Read_Safety_Products"><bpmn:sourceRef>Records_Safety_Products</bpmn:sourceRef><bpmn:targetRef>Input_Safety_Products</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataInputAssociation id="Read_Safety_Orders"><bpmn:sourceRef>Records_Safety_Orders</bpmn:sourceRef><bpmn:targetRef>Input_Safety_Orders</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="Write_Safety_Safety"><bpmn:sourceRef>Output_Safety_Safety</bpmn:sourceRef><bpmn:targetRef>Records_Safety_Safety</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:startEvent id="Safety_Start" name="">
        <bpmn:outgoing>Safety_F0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Safety_Task0" name="Identify affected&#10;products and batches">
        <bpmn:documentation>Read product/batch and producer order records. Identify the affected batches and relevant order identifiers. A concern may be identified locally or notified by the marketplace. Do not copy all customer contact data into the producer records merely to support traceability.</bpmn:documentation><bpmn:incoming>Safety_F0</bpmn:incoming>
        <bpmn:outgoing>Safety_F1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Safety_F0" sourceRef="Safety_Start" targetRef="Safety_Task0"/>
      <bpmn:task id="Safety_Task1" name="Coordinate traceability&#10;and safety communication">
        <bpmn:documentation>Send affected batch and order references to the marketplace so it can use its customer-product-producer links for rapid communication. Coordinate any required listing withdrawal and corrective action. Customer contact, incident escalation rules and any regulatory reporting require operational design; this model does not invent them.</bpmn:documentation><bpmn:incoming>Safety_F1</bpmn:incoming>
        <bpmn:outgoing>Safety_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Safety_F1" sourceRef="Safety_Task0" targetRef="Safety_Task1"/>
      <bpmn:task id="Safety_Task2" name="Record response and&#10;traceability evidence">
        <bpmn:documentation>Write the concern, affected batch/order references, actions and communications to shared safety response records. Keep response evidence available for follow-up. Completing this step records the response; it does not automatically certify that the safety issue is resolved.</bpmn:documentation><bpmn:incoming>Safety_F2</bpmn:incoming>
        <bpmn:outgoing>Safety_FEnd</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Safety_F2" sourceRef="Safety_Task1" targetRef="Safety_Task2"/>
      <bpmn:endEvent id="Safety_End" name="">
        <bpmn:incoming>Safety_FEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Safety_FEnd" sourceRef="Safety_Task2" targetRef="Safety_End"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Safety" name="Response&#10;recorded">
      <bpmn:incoming>Flow_Safety_Out</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Safety_In" sourceRef="Start_Safety" targetRef="Sub_Safety"/>
    <bpmn:sequenceFlow id="Flow_Safety_Out" sourceRef="Sub_Safety" targetRef="End_Safety"/>
  <bpmn:dataStoreReference id="Records_Safety_Products" name="Products, stock&#10;and batches" dataStoreRef="DataStore_Products"><bpmn:documentation>READ. This symbol refers to the same shared record set as matching symbols in the other producer processes. Product identifiers, names, descriptions, prices, availability, stock/allocation quantities, farm origin, postcode, harvest dates, certification status, allergens, best-before dates and batch traceability.</bpmn:documentation></bpmn:dataStoreReference><bpmn:dataStoreReference id="Records_Safety_Orders" name="Producer orders&#10;and fulfilment" dataStoreRef="DataStore_Orders"><bpmn:documentation>READ. This symbol refers to the same shared record set as matching symbols in the other producer processes. Order and producer identifiers, product/batch identifiers, quantities, prices, requested and agreed handover times, acceptance or issue status, fulfilled quantities and handover evidence. Customer contact records remain with the marketplace; traceability is coordinated using order identifiers.</bpmn:documentation></bpmn:dataStoreReference><bpmn:dataStoreReference id="Records_Safety_Safety" name="Safety response&#10;records" dataStoreRef="DataStore_Safety"><bpmn:documentation>WRITE. This symbol refers to the same shared record set as matching symbols in the other producer processes. Concern and product/batch identifiers, affected order references, actions taken, marketplace communications and follow-up evidence.</bpmn:documentation></bpmn:dataStoreReference></bpmn:process>
  <bpmn:process id="Process_Community" name="Producer - Community" isExecutable="false">
    <bpmn:documentation>Issue #15: producer-side strategic BPMN in strategic-producer.bpmn. This is one process view of the same local food producer, grouped with its other responsibilities. Separate process boundaries represent independently triggered work, not separate businesses or mandatory separate departments. Shared data-store references link catalogue/stock, orders, accounting and food safety responsibilities. Message flows show business information exchanges with the marketplace and payment provider; they do not implement API calls or money transfers. The model is intentionally non-executable. Camunda 8 deployment validation reports that no process is executable; do not mark it executable solely to hide that notice. An operational implementation needs actual task types, forms, variables, gateway conditions, service workers, message subscriptions and exception handling. Source requirements: Case Study - v2.pdf pp.1-2; strategic modelling requirement: Task 1 brief p.3. Allocation rules and delivery of financial updates through the marketplace are explicit design assumptions for later agreement.</bpmn:documentation><bpmn:startEvent id="Start_Community" name="Surplus or content&#10;identified">
      <bpmn:outgoing>Flow_Community_In</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_Community" name="Share surplus offers and&#10;seasonal learning content">
      <bpmn:documentation>Each update concerns surplus produce or educational content. Surplus messages include quantity, reduced price and seasonal availability. The marketplace publishes community updates.</bpmn:documentation>
      <bpmn:incoming>Flow_Community_In</bpmn:incoming>
      <bpmn:outgoing>Flow_Community_Out</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Community"><bpmn:dataInput id="Input_Community_Products" name="Products, stock and batches"/><bpmn:inputSet id="InputSet_Community"><bpmn:dataInputRefs>Input_Community_Products</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="OutputSet_Community"/></bpmn:ioSpecification><bpmn:dataInputAssociation id="Read_Community_Products"><bpmn:sourceRef>Records_Community_Products</bpmn:sourceRef><bpmn:targetRef>Input_Community_Products</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:startEvent id="Community_Start" name="">
        <bpmn:outgoing>Community_FDecision</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Community_Decision" name="Type of update?">
        <bpmn:incoming>Community_FDecision</bpmn:incoming>
        <bpmn:outgoing>Community_FYes0</bpmn:outgoing>
        <bpmn:outgoing>Community_FNo0</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Community_FDecision" sourceRef="Community_Start" targetRef="Community_Decision"/>
      <bpmn:task id="Community_Yes0" name="Set surplus quantity,&#10;discount and availability">
        <bpmn:incoming>Community_FYes0</bpmn:incoming>
        <bpmn:outgoing>Community_FYes1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Community_FYes0" sourceRef="Community_Decision" targetRef="Community_Yes0" name="Surplus"/>
      <bpmn:task id="Community_Yes1" name="Share surplus offer&#10;with marketplace">
        <bpmn:incoming>Community_FYes1</bpmn:incoming>
        <bpmn:outgoing>Community_FEndYes</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Community_FYes1" sourceRef="Community_Yes0" targetRef="Community_Yes1"/>
      <bpmn:endEvent id="Community_YesEnd" name="Offer shared">
        <bpmn:incoming>Community_FEndYes</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Community_FEndYes" sourceRef="Community_Yes1" targetRef="Community_YesEnd"/>
      <bpmn:task id="Community_No0" name="Prepare recipe, storage&#10;guidance or farm story">
        <bpmn:incoming>Community_FNo0</bpmn:incoming>
        <bpmn:outgoing>Community_FNo1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Community_FNo0" sourceRef="Community_Decision" targetRef="Community_No0" name="Learning content"/>
      <bpmn:task id="Community_No1" name="Share learning content&#10;with marketplace">
        <bpmn:incoming>Community_FNo1</bpmn:incoming>
        <bpmn:outgoing>Community_FEndNo</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Community_FNo1" sourceRef="Community_No0" targetRef="Community_No1"/>
      <bpmn:endEvent id="Community_NoEnd" name="Content shared">
        <bpmn:incoming>Community_FEndNo</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Community_FEndNo" sourceRef="Community_No1" targetRef="Community_NoEnd"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Community" name="Community&#10;update shared">
      <bpmn:incoming>Flow_Community_Out</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Community_In" sourceRef="Start_Community" targetRef="Sub_Community"/>
    <bpmn:sequenceFlow id="Flow_Community_Out" sourceRef="Sub_Community" targetRef="End_Community"/>
  <bpmn:dataStoreReference id="Records_Community_Products" name="Products, stock&#10;and batches" dataStoreRef="DataStore_Products"><bpmn:documentation>READ. This symbol refers to the same shared record set as matching symbols in the other producer processes. Product identifiers, names, descriptions, prices, availability, stock/allocation quantities, farm origin, postcode, harvest dates, certification status, allergens, best-before dates and batch traceability.</bpmn:documentation></bpmn:dataStoreReference></bpmn:process>
  <bpmn:category id="Category_ProducerOrganisation" name="Producer organisation"><bpmn:categoryValue id="CategoryValue_ProducerOrganisation" value="ONE LOCAL FOOD PRODUCER - five independently triggered process views"/></bpmn:category><bpmn:dataStore id="DataStore_Products" name="Products, stock and batches" isUnlimited="true"><bpmn:documentation>Product identifiers, names, descriptions, prices, availability, stock/allocation quantities, farm origin, postcode, harvest dates, certification status, allergens, best-before dates and batch traceability.</bpmn:documentation></bpmn:dataStore><bpmn:dataStore id="DataStore_Orders" name="Producer orders and fulfilment" isUnlimited="true"><bpmn:documentation>Order and producer identifiers, product/batch identifiers, quantities, prices, requested and agreed handover times, acceptance or issue status, fulfilled quantities and handover evidence. Customer contact records remain with the marketplace; traceability is coordinated using order identifiers.</bpmn:documentation></bpmn:dataStore><bpmn:dataStore id="DataStore_Settlements" name="Settlements and accounting evidence" isUnlimited="true"><bpmn:documentation>Weekly statement identifiers and line items, matched completed sales, gross sales, 5% commission, net amount, payment-provider transfer status, reconciliation results and query correspondence.</bpmn:documentation></bpmn:dataStore><bpmn:dataStore id="DataStore_Safety" name="Safety response records" isUnlimited="true"><bpmn:documentation>Concern and product/batch identifiers, affected order references, actions taken, marketplace communications and follow-up evidence.</bpmn:documentation></bpmn:dataStore><bpmndi:BPMNDiagram id="Diagram_Producer">
