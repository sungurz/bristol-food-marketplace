<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_BRFN_Customer_20261023" targetNamespace="https://brfn.example/coursework/customer" exporter="Camunda Web Modeler" exporterVersion="f127538" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:error id="Error_Cancel" name="Customer Cancelled" errorCode="CUSTOMER_CANCELLED" />
  <bpmn:error id="Error_Recheck" name="Checkout Review Required" errorCode="CHECKOUT_REVIEW_REQUIRED" />
  <bpmn:error id="Error_Refund" name="Payment Refunded" errorCode="PAYMENT_REFUNDED" />
  <bpmn:process id="BRFN_Customer_Journey_Review_20261023" name="Bristol Regional Food Network - Customer purchasing process" isExecutable="true">
    <bpmn:documentation>AI-assisted review draft, rebuilt from the supplied Bristol Regional Food Network case study. Students must review, revise and author their own assessment artefacts in accordance with their module policy. Scope: customer product discovery, basket management, checkout, simulated payment and order confirmation. Producer fulfilment and the weekly settlement run are separate processes. Four embedded subprocesses contain the operational detail; open their plus markers. The BPMN is structurally configured for Camunda 8; referenced forms and idempotent job workers must be implemented and tested before execution. No live payments, real credentials or real financial data are permitted. Implementation assumptions, worker contracts and scenario checks are in the accompanying review guide.</bpmn:documentation>
    <bpmn:startEvent id="Start_Journey" name="Customer wants&#10;local food">
      <bpmn:outgoing>Main_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_Discover" name="01  Discover products&#10;and build basket">
      <bpmn:incoming>Main_01</bpmn:incoming>
      <bpmn:outgoing>Main_02</bpmn:outgoing>
      <bpmn:startEvent id="D_Start" name="Start shopping">
        <bpmn:outgoing>D01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="D_Browse" name="Browse categories&#10;or search products">
        <bpmn:documentation>Customer filters vegetables, dairy, bakery, preserves and seasonal specialities, or searches by keyword. Surplus discounts are visible where available. Returns selected product identifiers.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="brfn-browse-products" />
        </bpmn:extensionElements>
        <bpmn:incoming>Merge_Discovery_out</bpmn:incoming>
        <bpmn:outgoing>D02</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="D_Inspect" name="Inspect product&#10;and producer details">
        <bpmn:documentation>Show description, price, farm origin, harvest dates, seasonal/stock availability, organic certification, allergen warnings and best-before dates. Recipes, storage guidance and farm stories may be accessed here. Customer can choose ADD, SEARCH or LEAVE through productAction.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="brfn-product-details" />
        </bpmn:extensionElements>
        <bpmn:incoming>D02</bpmn:incoming>
        <bpmn:outgoing>D03</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="D_ProductChoice" name="Add this product?" default="D05">
        <bpmn:incoming>D03</bpmn:incoming>
        <bpmn:outgoing>D04</bpmn:outgoing>
        <bpmn:outgoing>D05</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="D_Basket" name="Add items and&#10;review basket">
        <bpmn:documentation>Add or change quantities and remove lines. Preserve producer identifiers; a basket may contain products from one or many suppliers. Set basketDecision to CHECKOUT, SHOP or LEAVE.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="brfn-shopping-basket" />
        </bpmn:extensionElements>
        <bpmn:incoming>D04</bpmn:incoming>
        <bpmn:outgoing>D06</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="D_Decision" name="What next?" default="D09">
        <bpmn:incoming>D06</bpmn:incoming>
        <bpmn:outgoing>D07</bpmn:outgoing>
        <bpmn:outgoing>D08</bpmn:outgoing>
        <bpmn:outgoing>D09</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="D_Ready" name="Basket ready&#10;for checkout">
        <bpmn:incoming>D07</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="D_Leave" name="Shopping ended">
        <bpmn:incoming>D08</bpmn:incoming>
        <bpmn:errorEventDefinition id="D_Leave_definition" errorRef="Error_Cancel" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="D01" sourceRef="D_Start" targetRef="Merge_Discovery" />
      <bpmn:sequenceFlow id="D02" sourceRef="D_Browse" targetRef="D_Inspect" />
      <bpmn:sequenceFlow id="D03" sourceRef="D_Inspect" targetRef="D_ProductChoice" />
      <bpmn:sequenceFlow id="D04" name="Add" sourceRef="D_ProductChoice" targetRef="D_Basket">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= productAction = "ADD"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="D05" name="Search again" sourceRef="D_ProductChoice" targetRef="Merge_Discovery" />
      <bpmn:sequenceFlow id="D06" sourceRef="D_Basket" targetRef="D_Decision" />
      <bpmn:sequenceFlow id="D07" name="Checkout" sourceRef="D_Decision" targetRef="D_Ready">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= basketDecision = "CHECKOUT"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="D08" name="Leave" sourceRef="D_Decision" targetRef="D_Leave">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= basketDecision = "LEAVE"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="D09" name="Continue shopping" sourceRef="D_Decision" targetRef="Merge_Discovery" />
      <bpmn:exclusiveGateway id="Merge_Discovery" name="">
        <bpmn:incoming>D01</bpmn:incoming>
        <bpmn:incoming>D05</bpmn:incoming>
        <bpmn:incoming>D09</bpmn:incoming>
        <bpmn:outgoing>Merge_Discovery_out</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Merge_Discovery_out" sourceRef="Merge_Discovery" targetRef="D_Browse" />
      <bpmn:textAnnotation id="D_Note">
        <bpmn:text>CUSTOMER PRODUCT DISCOVERY
No stock is reserved or payment taken during browsing.</bpmn:text>
      </bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_Checkout" name="02  Review checkout&#10;and fulfilment">
      <bpmn:incoming>Merge_Checkout_out</bpmn:incoming>
      <bpmn:outgoing>Main_03</bpmn:outgoing>
      <bpmn:startEvent id="C_Start" name="Basket received">
        <bpmn:outgoing>C01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="C_Details" name="Enter contact and&#10;fulfilment choices">
        <bpmn:documentation>Collect customer details, postcode, delivery or collection choices and requested dates per producer. Show each supplier responsibility and delivery/collection arrangements. Use fictional data during testing.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="brfn-checkout-details" />
        </bpmn:extensionElements>
        <bpmn:incoming>Merge_Details_out</bpmn:incoming>
        <bpmn:outgoing>C02</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="C_Validate" name="Validate basket, stock&#10;and 48-hour lead time">
        <bpmn:documentation>Validate a non-empty basket, positive quantities, current listings/prices and stock/seasonal timeframes. Check customer details and the 20-mile service area where relevant to delivery. Check requested preparation/fulfilment time for every producer is at least 48 hours after the modelled preparation start. Return checkoutValid boolean and human-readable validationIssues. Do not take payment. Recalculate all values after basket edits.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-validate-checkout" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>C02</bpmn:incoming>
        <bpmn:outgoing>C03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="C_Eligible" name="Checkout valid?" default="C05">
        <bpmn:incoming>C03</bpmn:incoming>
        <bpmn:outgoing>C04</bpmn:outgoing>
        <bpmn:outgoing>C05</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="C_Quote" name="Calculate total and&#10;producer breakdown">
        <bpmn:documentation>Create an immutable quote version with quantities, agreed product prices, per-producer subtotals, delivery/collection details, fulfilment times and total. Include postcode-based food miles as an estimate. Quote expiry and basis require group agreement. A later changed quote requires renewed customer consent.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-quote-checkout" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>C04</bpmn:incoming>
        <bpmn:outgoing>C09</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="C_Accept" name="Review total, suppliers&#10;and confirm checkout">
        <bpmn:documentation>Display total, per-producer lines, dates, responsibilities, delivery/collection arrangements and food miles. Show traceability information and any relevant surplus discounts. Set quoteAccepted true only after customer confirms the current quote; otherwise false.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="brfn-confirm-checkout" />
        </bpmn:extensionElements>
        <bpmn:incoming>C09</bpmn:incoming>
        <bpmn:outgoing>C10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="C_Agreed" name="Quote accepted?" default="C12">
        <bpmn:incoming>C10</bpmn:incoming>
        <bpmn:outgoing>C11</bpmn:outgoing>
        <bpmn:outgoing>C12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="C_Ready" name="Checkout approved">
        <bpmn:incoming>C11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="C_Amend" name="Correct details,&#10;amend basket or cancel">
        <bpmn:documentation>Present validationIssues and allow changing quantities, supplier choices or fulfilment date. Set checkoutDecision to REVISE or CANCEL. Revised baskets return through full validation, fresh pricing and renewed customer consent.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="brfn-amend-checkout" />
        </bpmn:extensionElements>
        <bpmn:incoming>C05</bpmn:incoming>
        <bpmn:outgoing>C06</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="C_AmendDecision" name="Continue?" default="C07">
        <bpmn:incoming>C06</bpmn:incoming>
        <bpmn:outgoing>C07</bpmn:outgoing>
        <bpmn:outgoing>C08</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="C_Cancel" name="Checkout cancelled">
        <bpmn:incoming>C08</bpmn:incoming>
        <bpmn:errorEventDefinition id="C_Cancel_definition" errorRef="Error_Cancel" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="C01" sourceRef="C_Start" targetRef="Merge_Details" />
      <bpmn:sequenceFlow id="C02" sourceRef="C_Details" targetRef="C_Validate" />
      <bpmn:sequenceFlow id="C03" sourceRef="C_Validate" targetRef="C_Eligible" />
      <bpmn:sequenceFlow id="C04" name="Valid" sourceRef="C_Eligible" targetRef="C_Quote">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= checkoutValid = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="C05" name="Needs correction" sourceRef="C_Eligible" targetRef="C_Amend" />
      <bpmn:sequenceFlow id="C06" sourceRef="C_Amend" targetRef="C_AmendDecision" />
      <bpmn:sequenceFlow id="C07" name="Revise" sourceRef="C_AmendDecision" targetRef="Merge_Details" />
      <bpmn:sequenceFlow id="C08" name="Cancel" sourceRef="C_AmendDecision" targetRef="C_Cancel">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= checkoutDecision = "CANCEL"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="C09" sourceRef="C_Quote" targetRef="C_Accept" />
      <bpmn:sequenceFlow id="C10" sourceRef="C_Accept" targetRef="C_Agreed" />
      <bpmn:sequenceFlow id="C11" name="Confirm" sourceRef="C_Agreed" targetRef="C_Ready">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= quoteAccepted = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="C12" name="Revise checkout" sourceRef="C_Agreed" targetRef="Merge_Details" />
      <bpmn:exclusiveGateway id="Merge_Details" name="">
        <bpmn:incoming>C01</bpmn:incoming>
        <bpmn:incoming>C07</bpmn:incoming>
        <bpmn:incoming>C12</bpmn:incoming>
        <bpmn:outgoing>Merge_Details_out</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Merge_Details_out" sourceRef="Merge_Details" targetRef="C_Details" />
      <bpmn:textAnnotation id="C_Note">
        <bpmn:text>BEFORE PAYMENT
Validate each producer, not only the master order. The minimum preparation lead time is 48 hours.</bpmn:text>
      </bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_Payment" name="03  Reserve stock&#10;and test payment">
      <bpmn:incoming>Main_03</bpmn:incoming>
      <bpmn:outgoing>Main_04</bpmn:outgoing>
      <bpmn:startEvent id="P_Start" name="Approved quote">
        <bpmn:outgoing>P01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="P_Reserve" name="Recheck quote and&#10;reserve all stock">
        <bpmn:documentation>Atomically verify current stock, quote version/prices and preparation lead time; reserve all basket lines or roll back every partial reservation. Return reservationSucceeded boolean. No changed total may be charged without customer review. Use checkoutId for idempotency. A renewed attempt rechecks all conditions. Reservations must not be silently expired while payment remains unresolved; use controlled holds and an auditable recovery policy.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-reserve-stock" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Merge_Reservation_out</bpmn:incoming>
        <bpmn:outgoing>P02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_Reserved" name="Reservation valid?" default="P04">
        <bpmn:incoming>P02</bpmn:incoming>
        <bpmn:outgoing>P03</bpmn:outgoing>
        <bpmn:outgoing>P04</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="P_Prepare" name="Prepare idempotent&#10;test payment request">
        <bpmn:documentation>Create or recover checkoutId, paymentAttempt and stable idempotency key for the approved quote. Technical retries reuse the same key. A new customer-approved attempt after a definitively declined attempt receives a new attempt key. Persist attempt count durably and enforce the group-agreed maximum. Never create another attempt while an earlier attempt is unresolved.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-prepare-test-payment" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>P03</bpmn:incoming>
        <bpmn:outgoing>P05</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P_Pay" name="Process simulated&#10;payment">
        <bpmn:documentation>Use only a mock or sandbox provider and fictional data. Return paymentOutcome APPROVED, DECLINED or UNKNOWN plus provider transaction reference. Technical retries use the same idempotency key and return the recorded result. Do not interpret a timeout as a decline. No live payment data or credentials.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-simulated-payment" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>P05</bpmn:incoming>
        <bpmn:outgoing>P06</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_Outcome" name="Payment outcome?" default="P08">
        <bpmn:incoming>P06</bpmn:incoming>
        <bpmn:outgoing>P07</bpmn:outgoing>
        <bpmn:outgoing>P08</bpmn:outgoing>
        <bpmn:outgoing>P09</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="P_Paid" name="Test payment&#10;approved">
        <bpmn:incoming>Merge_Approved_out</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="P_Recheck" name="Revised checkout&#10;required">
        <bpmn:incoming>P04</bpmn:incoming>
        <bpmn:errorEventDefinition id="P_Recheck_definition" errorRef="Error_Recheck" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="P_Reconcile" name="Reconcile existing&#10;payment attempt">
        <bpmn:documentation>Look up the existing transaction using its idempotency key/provider reference. Do not initiate a charge. Return reconciledStatus APPROVED, DECLINED or UNKNOWN. Keep an auditable reservation hold while unresolved; confirmed payment is revalidated before order creation. Operator investigation cannot itself assert an unverified successful payment.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-reconcile-test-payment" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Merge_Reconcile_out</bpmn:incoming>
        <bpmn:outgoing>P10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_Reconciled" name="Verified outcome?" default="P13">
        <bpmn:incoming>P10</bpmn:incoming>
        <bpmn:outgoing>P11</bpmn:outgoing>
        <bpmn:outgoing>P12</bpmn:outgoing>
        <bpmn:outgoing>P13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P_Investigate" name="Investigate unresolved&#10;test payment">
        <bpmn:documentation>Marketplace operator checks the existing sandbox/mock transaction and reservation hold. Record evidence and complete investigation so the reconciliation worker queries the provider again. Never retry or release stock solely because a payment outcome is unknown. This is an operator task, not a customer decision.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="brfn-investigate-payment" />
        </bpmn:extensionElements>
        <bpmn:incoming>P13</bpmn:incoming>
        <bpmn:outgoing>P14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="P_Release" name="Release stock after&#10;verified decline">
        <bpmn:documentation>Release the full reservation idempotently only after verified DECLINED. Record provider reference and reason. No order is created. Return permittedRetry based on the durable attempt count and the group-agreed retry limit.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-release-declined-stock" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Merge_Declined_out</bpmn:incoming>
        <bpmn:outgoing>P15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="P_Retry" name="Choose another test&#10;attempt or cancel">
        <bpmn:documentation>Tell the customer the previous test payment was definitively declined. Set retryPayment true or false. Display remaining permitted attempts. Never ask for real card data. Cancellation is safe because the declined reservation has already been released.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="brfn-retry-payment" />
        </bpmn:extensionElements>
        <bpmn:incoming>P15</bpmn:incoming>
        <bpmn:outgoing>P16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P_RetryDecision" name="Retry permitted?" default="P18">
        <bpmn:incoming>P16</bpmn:incoming>
        <bpmn:outgoing>P17</bpmn:outgoing>
        <bpmn:outgoing>P18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="P_Cancel" name="Payment cancelled">
        <bpmn:incoming>P18</bpmn:incoming>
        <bpmn:errorEventDefinition id="P_Cancel_definition" errorRef="Error_Cancel" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P01" sourceRef="P_Start" targetRef="Merge_Reservation" />
      <bpmn:sequenceFlow id="P02" sourceRef="P_Reserve" targetRef="P_Reserved" />
      <bpmn:sequenceFlow id="P03" name="Reserved" sourceRef="P_Reserved" targetRef="P_Prepare">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reservationSucceeded = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P04" name="Unavailable / changed" sourceRef="P_Reserved" targetRef="P_Recheck" />
      <bpmn:sequenceFlow id="P05" sourceRef="P_Prepare" targetRef="P_Pay" />
      <bpmn:sequenceFlow id="P06" sourceRef="P_Pay" targetRef="P_Outcome" />
      <bpmn:sequenceFlow id="P07" name="Approved" sourceRef="P_Outcome" targetRef="Merge_Approved">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentOutcome = "APPROVED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P08" name="Unknown / timeout" sourceRef="P_Outcome" targetRef="Merge_Reconcile" />
      <bpmn:sequenceFlow id="P09" name="Declined" sourceRef="P_Outcome" targetRef="Merge_Declined">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentOutcome = "DECLINED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10" sourceRef="P_Reconcile" targetRef="P_Reconciled" />
      <bpmn:sequenceFlow id="P11" name="Verified approval" sourceRef="P_Reconciled" targetRef="Merge_Approved">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reconciledStatus = "APPROVED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P12" name="Verified decline" sourceRef="P_Reconciled" targetRef="Merge_Declined">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reconciledStatus = "DECLINED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P13" name="Still unresolved" sourceRef="P_Reconciled" targetRef="P_Investigate" />
      <bpmn:sequenceFlow id="P14" name="Re-query same attempt" sourceRef="P_Investigate" targetRef="Merge_Reconcile" />
      <bpmn:sequenceFlow id="P15" sourceRef="P_Release" targetRef="P_Retry" />
      <bpmn:sequenceFlow id="P16" sourceRef="P_Retry" targetRef="P_RetryDecision" />
      <bpmn:sequenceFlow id="P17" name="Retry and recheck" sourceRef="P_RetryDecision" targetRef="Merge_Reservation">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryPayment = true and permittedRetry = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P18" name="Cancel / limit reached" sourceRef="P_RetryDecision" targetRef="P_Cancel" />
      <bpmn:exclusiveGateway id="Merge_Reservation" name="">
        <bpmn:incoming>P01</bpmn:incoming>
        <bpmn:incoming>P17</bpmn:incoming>
        <bpmn:outgoing>Merge_Reservation_out</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Merge_Reservation_out" sourceRef="Merge_Reservation" targetRef="P_Reserve" />
      <bpmn:exclusiveGateway id="Merge_Approved" name="">
        <bpmn:incoming>P07</bpmn:incoming>
        <bpmn:incoming>P11</bpmn:incoming>
        <bpmn:outgoing>Merge_Approved_out</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Merge_Approved_out" sourceRef="Merge_Approved" targetRef="P_Paid" />
      <bpmn:exclusiveGateway id="Merge_Reconcile" name="">
        <bpmn:incoming>P08</bpmn:incoming>
        <bpmn:incoming>P14</bpmn:incoming>
        <bpmn:outgoing>Merge_Reconcile_out</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Merge_Reconcile_out" sourceRef="Merge_Reconcile" targetRef="P_Reconcile" />
      <bpmn:exclusiveGateway id="Merge_Declined" name="">
        <bpmn:incoming>P09</bpmn:incoming>
        <bpmn:incoming>P12</bpmn:incoming>
        <bpmn:outgoing>Merge_Declined_out</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Merge_Declined_out" sourceRef="Merge_Declined" targetRef="P_Release" />
      <bpmn:textAnnotation id="P_Note">
        <bpmn:text>PAYMENT SAFETY
A timeout is not a decline. Reconcile the same attempt before another charge.
Reservation failures roll back partial holds; customer changes require a new approved quote.</bpmn:text>
      </bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_Confirm" name="04  Create orders&#10;and confirm">
      <bpmn:incoming>Main_04</bpmn:incoming>
      <bpmn:outgoing>Main_05</bpmn:outgoing>
      <bpmn:startEvent id="O_Start" name="Payment approved">
        <bpmn:outgoing>O01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="O_Recheck" name="Recheck reservation&#10;and preparation time">
        <bpmn:documentation>Verify the approved payment matches checkoutId/quote total, the reservation remains available and each producer still has at least 48 hours preparation before the agreed fulfilment time. Return confirmationValid boolean. Long-running reconciliation must not silently invalidate the preparation requirement. Failure after approved payment routes to a verified simulated refund.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-check-confirmation" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>O01</bpmn:incoming>
        <bpmn:outgoing>O02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="O_Valid" name="Can confirm?" default="O04">
        <bpmn:incoming>O02</bpmn:incoming>
        <bpmn:outgoing>O03</bpmn:outgoing>
        <bpmn:outgoing>O04</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="O_Commission" name="Allocate network&#10;commission of 5%">
        <bpmn:documentation>Calculate the network 5% commission and producer net amounts from the frozen accepted quote. Proposed convention requiring group approval: commission on each producer merchandise subtotal, excluding delivery charges; GBP decimal arithmetic, half-up to two decimal places per producer. Do not add this commission as an undisclosed customer fee. Preserve gross = commission + producer net exactly and record the calculation basis.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-calculate-commission" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>O03</bpmn:incoming>
        <bpmn:outgoing>O05</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="O_Orders" name="Create master order&#10;and producer orders">
        <bpmn:documentation>Idempotent atomic commit keyed by checkoutId: create one master order and one child per distinct producer, even for a single-producer basket. Persist customer-product-producer links, quote/product traceability snapshots, organic/allergen/best-before information, quantities, per-producer delivery/collection commitments and confirmed dates. Consume reservations once. Return orderCreationSucceeded true only after the complete commit. On false, guarantee no active partial orders remain. Technical uncertainty must be reconciled by the worker rather than reported as a definite failure.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-create-orders" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>O05</bpmn:incoming>
        <bpmn:outgoing>O06</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="O_Created" name="Orders committed?" default="O08">
        <bpmn:incoming>O06</bpmn:incoming>
        <bpmn:outgoing>O07</bpmn:outgoing>
        <bpmn:outgoing>O08</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="O_Ledger" name="Record audit trail and&#10;weekly settlement due">
        <bpmn:documentation>Write idempotent producer gross, 5% commission, net, payment reference and weekly settlement-due records for tax/accounting audit. This records the obligation only; the separate weekly settlement process performs simulated distribution. Customer checkout must not wait for a weekly timer. Preserve committed orders if this job requires technical retry or incident resolution.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-record-settlement" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>O07</bpmn:incoming>
        <bpmn:outgoing>O09</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="O_Notify" name="Queue customer receipt&#10;and producer notices">
        <bpmn:documentation>Durably enqueue one customer confirmation and each producer notice with order references, supplier responsibilities, preparation time and delivery/collection arrangements. Use an outbox and idempotent message keys; notification delivery retries occur separately without cancelling committed orders. Producers must receive adequate preparation lead time: apply notification delivery monitoring and escalation, and renegotiate/refund if the 48-hour commitment can no longer be honoured. Worker completion requires durable queueing, not a best-effort send.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-queue-confirmations" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>O09</bpmn:incoming>
        <bpmn:outgoing>O10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="O_Done" name="Order confirmed">
        <bpmn:incoming>O10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="O_Refund" name="Refund approved&#10;simulated payment">
        <bpmn:documentation>Issue or recover one sandbox/mock refund for the original approved payment reference; use a stable refund idempotency key. Complete only after verified refund success. Unknown refund results must be reconciled or raised as an incident; do not falsely signal that the customer has been refunded. Never refund a transaction for a confirmed order solely because a later notification or ledger job failed.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-refund-test-payment" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Merge_Refund_out</bpmn:incoming>
        <bpmn:outgoing>O11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="O_Release" name="Void incomplete orders&#10;and release reservation">
        <bpmn:documentation>After verified test refund, idempotently close the failed checkout, ensure no active partial producer orders remain and release every unused stock reservation. Preserve all payment/refund and cancellation audit records. Do not release stock already consumed by a valid committed order.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-close-failed-checkout" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>O11</bpmn:incoming>
        <bpmn:outgoing>O12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="O_Refunded" name="Test payment refunded;&#10;order not confirmed">
        <bpmn:incoming>O12</bpmn:incoming>
        <bpmn:errorEventDefinition id="O_Refunded_definition" errorRef="Error_Refund" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="O01" sourceRef="O_Start" targetRef="O_Recheck" />
      <bpmn:sequenceFlow id="O02" sourceRef="O_Recheck" targetRef="O_Valid" />
      <bpmn:sequenceFlow id="O03" name="Valid" sourceRef="O_Valid" targetRef="O_Commission">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= confirmationValid = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="O04" name="Cannot honour checkout" sourceRef="O_Valid" targetRef="Merge_Refund" />
      <bpmn:sequenceFlow id="O05" sourceRef="O_Commission" targetRef="O_Orders" />
      <bpmn:sequenceFlow id="O06" sourceRef="O_Orders" targetRef="O_Created" />
      <bpmn:sequenceFlow id="O07" name="Committed" sourceRef="O_Created" targetRef="O_Ledger">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= orderCreationSucceeded = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="O08" name="Creation failed" sourceRef="O_Created" targetRef="Merge_Refund" />
      <bpmn:sequenceFlow id="O09" sourceRef="O_Ledger" targetRef="O_Notify" />
      <bpmn:sequenceFlow id="O10" sourceRef="O_Notify" targetRef="O_Done" />
      <bpmn:sequenceFlow id="O11" sourceRef="O_Refund" targetRef="O_Release" />
      <bpmn:sequenceFlow id="O12" sourceRef="O_Release" targetRef="O_Refunded" />
      <bpmn:exclusiveGateway id="Merge_Refund" name="">
        <bpmn:incoming>O04</bpmn:incoming>
        <bpmn:incoming>O08</bpmn:incoming>
        <bpmn:outgoing>Merge_Refund_out</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Merge_Refund_out" sourceRef="Merge_Refund" targetRef="O_Refund" />
      <bpmn:textAnnotation id="O_Note">
        <bpmn:text>ORDER INTEGRITY
Keep the frozen customer quote and product traceability.
Technical failures retry idempotently. Confirmed orders survive delayed notices.
Weekly settlement execution and producer fulfilment are separate workflows.</bpmn:text>
      </bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Confirmed" name="Order confirmed">
      <bpmn:incoming>Main_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cancelled" name="Purchase cancelled">
      <bpmn:incoming>Merge_Cancel_out</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Refunded" name="Order not confirmed;&#10;test payment refunded">
      <bpmn:incoming>Main_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_Checkout" name="">
      <bpmn:incoming>Main_02</bpmn:incoming>
      <bpmn:incoming>Main_09</bpmn:incoming>
      <bpmn:outgoing>Merge_Checkout_out</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Merge_Cancel" name="">
      <bpmn:incoming>Main_06</bpmn:incoming>
      <bpmn:incoming>Main_07</bpmn:incoming>
      <bpmn:incoming>Main_08</bpmn:incoming>
      <bpmn:outgoing>Merge_Cancel_out</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="Catch_Refund" name="Refund completed" attachedToRef="Sub_Confirm">
      <bpmn:outgoing>Main_10</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Catch_Refund_definition" errorRef="Error_Refund" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Catch_PaymentCancel" name="Cancel" attachedToRef="Sub_Payment">
      <bpmn:outgoing>Main_08</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Catch_PaymentCancel_definition" errorRef="Error_Cancel" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Catch_Recheck" name="Review again" attachedToRef="Sub_Payment">
      <bpmn:outgoing>Main_09</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Catch_Recheck_definition" errorRef="Error_Recheck" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Catch_CheckoutCancel" name="Cancel" attachedToRef="Sub_Checkout">
      <bpmn:outgoing>Main_07</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Catch_CheckoutCancel_definition" errorRef="Error_Cancel" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Catch_Leave" name="Leave" attachedToRef="Sub_Discover">
      <bpmn:outgoing>Main_06</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Catch_Leave_definition" errorRef="Error_Cancel" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Main_01" sourceRef="Start_Journey" targetRef="Sub_Discover" />
    <bpmn:sequenceFlow id="Main_02" sourceRef="Sub_Discover" targetRef="Merge_Checkout" />
    <bpmn:sequenceFlow id="Merge_Checkout_out" sourceRef="Merge_Checkout" targetRef="Sub_Checkout" />
    <bpmn:sequenceFlow id="Main_03" sourceRef="Sub_Checkout" targetRef="Sub_Payment" />
    <bpmn:sequenceFlow id="Main_04" sourceRef="Sub_Payment" targetRef="Sub_Confirm" />
    <bpmn:sequenceFlow id="Main_05" sourceRef="Sub_Confirm" targetRef="End_Confirmed" />
    <bpmn:sequenceFlow id="Merge_Cancel_out" sourceRef="Merge_Cancel" targetRef="End_Cancelled" />
    <bpmn:sequenceFlow id="Main_10" sourceRef="Catch_Refund" targetRef="End_Refunded" />
    <bpmn:sequenceFlow id="Main_09" sourceRef="Catch_Recheck" targetRef="Merge_Checkout" />
    <bpmn:sequenceFlow id="Main_06" sourceRef="Catch_Leave" targetRef="Merge_Cancel" />
    <bpmn:sequenceFlow id="Main_07" sourceRef="Catch_CheckoutCancel" targetRef="Merge_Cancel" />
    <bpmn:sequenceFlow id="Main_08" sourceRef="Catch_PaymentCancel" targetRef="Merge_Cancel" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Customer" name="BRFN Customer-side Processes - Review Draft">
    <bpmn:participant id="Participant_BRFN" name="BRFN | Customer purchasing process" processRef="BRFN_Customer_Journey_Review_20261023" />
    <bpmn:textAnnotation id="Note_Discovery">
      <bpmn:text>Search categories; inspect origin, harvest dates, seasonal availability, allergens and best-before dates.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Checkout">
      <bpmn:text>Single or multiple producers. Agree delivery/collection for each supplier and at least 48 hours preparation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Payment">
      <bpmn:text>SIMULATED PAYMENTS ONLY
Stock is rechecked. Unknown outcomes are reconciled before any new attempt.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Orders">
      <bpmn:text>One master order plus producer orders; automatic 5% commission; traceability; weekly settlement records.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Hierarchy">
      <bpmn:text>CUSTOMER PROCESS  |  Open each + marker for detailed BPMN.
Blue = human task   Green = automated task   Amber = decision</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
