# Optional: node --env-file=.env src/camunda-stock-worker.js
CAMUNDA_REST_URL=http://localhost:8080/v2
# CAMUNDA_TOKEN=local-or-test-token-if-required
# Choose one trusted source. The default file is demonstration data.
STOCK_FILE=examples/stock-catalogue.json
# STOCK_URL=http://localhost:8090/products
# STOCK_TOKEN=test-stock-service-token-if-required
STOCK_TIMEOUT_MS=5000
CAMUNDA_REQUEST_TIMEOUT_MS=10000
CAMUNDA_ACTIVATION_TIMEOUT_MS=5000
STOCK_JOB_TIMEOUT_MS=60000
STOCK_POLL_MS=500
