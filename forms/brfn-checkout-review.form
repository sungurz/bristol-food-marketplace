{
  "components": [
    {
      "text": "### Review your order\nEach producer prepares their part of your order separately. Producers need at least 48 hours to prepare, so your earliest delivery or collection date is 48 hours from now.",
      "type": "text",
      "layout": {
        "row": "Row_1epg8vn",
        "columns": null
      },
      "id": "Field_0m96bim"
    },
    {
      "type": "table",
      "id": "Field_review_items",
      "label": "Your items",
      "dataSource": "=orderQuote.items",
      "rowCount": 10,
      "layout": {
        "row": "Row_review_items",
        "columns": null
      },
      "columns": [
        {
          "label": "Producer",
          "key": "producerId"
        },
        {
          "label": "Product",
          "key": "productId"
        },
        {
          "label": "Quantity",
          "key": "quantity"
        },
        {
          "label": "Price each (pence)",
          "key": "unitPriceInPence"
        },
        {
          "label": "Line total (pence)",
          "key": "lineTotalInPence"
        }
      ]
    },
    {
      "type": "text",
      "id": "Field_review_total",
      "text": "=\"**Total to pay: \u00a3\" + string(floor(orderQuote.totalInPence / 100)) + \".\" + (if modulo(orderQuote.totalInPence, 100) < 10 then \"0\" else \"\") + string(modulo(orderQuote.totalInPence, 100)) + \"**\"",
      "conditional": {
        "hide": "=orderQuote.totalInPence = null"
      },
      "layout": {
        "row": "Row_review_total",
        "columns": null
      }
    },
    {
      "type": "table",
      "layout": {
        "row": "Row_1rcio8e",
        "columns": null
      },
      "label": "Your delivery and collection choices",
      "dataSource": "=fulfilmentSelections",
      "rowCount": 10,
      "id": "Field_0e42ju1",
      "columns": [
        {
          "key": "producerId",
          "label": "Producer"
        },
        {
          "label": "Delivery or collection",
          "key": "fulfilmentMethod"
        },
        {
          "label": "Date",
          "key": "scheduledFor"
        }
      ]
    },
    {
      "label": "What would you like to do?",
      "values": [
        {
          "label": "Confirm order",
          "value": "confirm"
        },
        {
          "label": "Change my basket",
          "value": "amend"
        },
        {
          "label": "Cancel checkout",
          "value": "cancel"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_0hgskwt",
        "columns": null
      },
      "id": "Field_0k1kspd",
      "key": "checkoutDecision",
      "validate": {
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "brfn-checkout-review",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  },
  "schemaVersion": 19
}